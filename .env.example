# Docker 部署环境变量（复制为 .env 后修改）
# Watchtower HTTP API 令牌，app 与 watchtower 两侧必须一致；生产环境务必修改
WATCHTOWER_TOKEN=please-change-me

# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
HUOBAO_VERSION=dev

# 织界玩家模式（本地开发写在 backend/.env，见 backend/.env.example）
# CODECC_API_KEY=
# CODECC_BASE_URL=https://codecc.cc
# CODECC_TEXT_MODEL=grok-4.7
# CODECC_IMAGE_MODEL=grok-imagine-image-quality
# CODECC_VIDEO_MODEL=grok-imagine-video-1.5
